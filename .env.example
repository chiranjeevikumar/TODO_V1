# ── Gmail Email Alert Configuration ──────────────────────────────────────────
#
# Copy this file to ".env" and fill in your values.
# NEVER commit your actual .env to git (it's already in .gitignore).
#
# How to get a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already on)
#   3. Search for "App Passwords" at the top of that page
#   4. Create an app password for "Mail" / "Other (Custom name)"
#   5. Copy the 16-character password below (spaces are OK)
# ─────────────────────────────────────────────────────────────────────────────

# Gmail address used to SEND emails
GMAIL_USER=chiranjeevi42054205@gmail.com

# 16-character App Password from Google Account → Security → App Passwords
GMAIL_APP_PASSWORD=pdje ziwo ckyj yzbs

# Email address that will RECEIVE the reminder alerts (can be same as GMAIL_USER)
NOTIFICATION_EMAIL=chiranjeevikumarbattula@gmail.com

# ── Optional: Database ────────────────────────────────────────────────────────
# Leave blank to use local SQLite (todo.db). Set to a PostgreSQL URL for prod.
# DATABASE_URL=postgresql://user:password@host/dbname
